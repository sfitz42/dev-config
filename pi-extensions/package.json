{
  "name": "@dev-config/pi-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit": "pnpm audit --prod",
    "schema:check": "pnpm -r --if-present run schema:check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm schema:check && pnpm audit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "neostandard": "0.14.1",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
