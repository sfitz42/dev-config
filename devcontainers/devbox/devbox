#!/usr/bin/env bash
# devbox: one persistent dev container per project. The implementation is Python
# (src/dotfiles/devbox), run through uv; `devbox help` lists the commands.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/../.." && pwd)"
command -v uv >/dev/null || { echo "devbox: uv not found (run scripts/bootstrap.sh)" >&2; exit 1; }
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --quiet --project "$ROOT" python -m dotfiles.devbox "$@"
