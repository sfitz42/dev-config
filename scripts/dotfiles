#!/usr/bin/env bash
# Entry point: runs the Python installer through uv (deps and Python are handled by uv).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v uv >/dev/null || { echo "uv not found: run scripts/bootstrap.sh first" >&2; exit 1; }
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --quiet --project "$ROOT" python -m dotfiles "$@"
