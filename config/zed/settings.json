// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Machine-specific "ssh_connections" are deliberately not tracked (Zed adds them to this file;
  // remove them before committing, or keep them in the unlinked ~/.config/zed copy).
  "terminal": {
    "font_size": 13.0,
    "font_family": "MesloLGS NF"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "project_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
