# Aliases. Everything here is safe to share; machine-specific ones go in local/zshrc.local.

# Listing
alias ll='ls -lh'
alias la='ls -lAh'

# Coding agents
alias c='claude'
alias cr='claude -r'

# Editor
alias z.='zed .'

# Apple `container`
alias ce='container exec -it'
alias cls='container list --all'
